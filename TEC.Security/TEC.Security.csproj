<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança, AOT e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Security</RootNamespace>
    <Description>Identidade e permissões com uma única API para qualquer provedor de login: usuário, tenant e permissões normalizados, API keys guardadas só como hash e tokens de serviço anexados apenas aos destinos autorizados.</Description>
    <PackageTags>security;authentication;authorization;multi-tenant;api-key;zero-trust;tec</PackageTags>
    <!-- Binding de IConfiguration gerado em compilação (compatível com Native AOT/trimming) -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!--
    Núcleo sem ASP.NET Core e sem SDK de provedor de identidade: usado também por workers e mensageria.
    TEC.Core: pacote do feed interno (tec-interno); já traz Microsoft.Extensions.DependencyInjection.Abstractions.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Polly.Core" />
    <TecReference Include="TEC.Core" />
  </ItemGroup>

  <!--
    O login web do TEC.Security.AspNetCore reconstrói a identidade normalizada lida do próprio cookie de sessão
    (NormalizedIdentity.RestoreTrusted). O tipo é interno de propósito: fora dos pacotes TEC.Security, só o
    SecurityIdentityFactory cria identidade normalizada. Os quatro pacotes saem sempre na mesma versão.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="TEC.Security.AspNetCore" />
  </ItemGroup>

</Project>

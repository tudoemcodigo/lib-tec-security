<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de carga: concorrência nos singletons, volume, soak (longa duração) e carga HTTP numa API protegida pelo
    TEC.Security (Kestrel real em 127.0.0.1). Os testes rápidos (categoria Carga-CI) rodam no CI a cada PR; os pesados (Carga-Pesada) têm [Explicit] e só rodam
    quando selecionados pela categoria (veja docs/testes.md). Framework, lock file e auditoria de pacotes em ../Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CA5394: o System.Random só sorteia cenários e dados de carga (reproduzíveis por semente); não gera segredo nem token -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Security\TEC.Security.csproj" />
    <ProjectReference Include="..\TEC.Security.AspNetCore\TEC.Security.AspNetCore.csproj" />
    <ProjectReference Include="..\TEC.Security.Testing\TEC.Security.Testing.csproj" />
  </ItemGroup>

</Project>
